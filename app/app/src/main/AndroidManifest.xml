<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="SenzSpace"
        android:theme="@style/Theme.SenzSpace"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- S0: satu proses per Space, supaya WebView.setDataDirectorySuffix
             benar-benar memisahkan cookie/storage antar Space. -->
        <activity
            android:name=".Space1Activity"
            android:process=":space1"
            android:exported="false" />
        <activity
            android:name=".Space2Activity"
            android:process=":space2"
            android:exported="false" />

    </application>
</manifest>
